{
  // Static site served by Cloudflare Workers Static Assets.
  // worker/index.js only handles GitHub sign-in for the content editor (/api/auth, /api/callback).
  // Pages are generated from content/*.json by `python3 tools/build_preview.py` (set as the Build command in Cloudflare).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "microbiome-website",
  "compatibility_date": "2026-11-09",
  "main": "worker/index.js",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
